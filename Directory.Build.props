<Project>

  <PropertyGroup>
    <!-- This repo is Unity-first. .NET projects are retained as build and test harnesses. -->
    <RepositoryUrl>https://github.com/Quantum-Lion-Labs/Luau-Unity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and ('$(MSBuildProjectName)' == 'Luau' or '$(MSBuildProjectName)' == 'Luau.SourceGenerator' or '$(MSBuildProjectName)' == 'Luau.Interop')">
    <!-- Shipped Unity DLLs must reproduce independently of checkout path and HEAD. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
